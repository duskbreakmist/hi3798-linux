# MV100 ARMv7 shared board profile; select direct or diagnostic root separately.
CONFIG_LOCALVERSION="-hi3798-mv100-exp"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_XZ=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EXPERT=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_HISI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_HIGHMEM=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
# eMMC on this board has no MBR/GPT; HiSilicon defines the layout with
# blkdevparts= on the command line. Mainline parses that natively once
# PARTITION_ADVANCED + CMDLINE_PARTITION are enabled.
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_MFD_SYSCON=y
CONFIG_GENERIC_PHY=y
CONFIG_REGULATOR=y
CONFIG_PM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_HI3798CV200=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_OVERLAY_FS=y
CONFIG_DRM=y
CONFIG_DRM_LIMA=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Without /proc/sys, systemd-journald dies on "Failed to open
# /proc/sys/kernel/hostname" and every unit logs "Connection refused".
CONFIG_PROC_SYSCTL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=y
CONFIG_MAGIC_SYSRQ=y
# SysRq over the serial console: BREAK followed by a command letter. Lets a
# wedged board dump blocked task stacks without needing a login shell, which
# matters while address configuration can still hang the kernel.
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_PRINTK_TIME=y

CONFIG_MACH_HI3798MV100=y
CONFIG_COMMON_CLK_HI3798MV100=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE="console=ttyAMA0,115200 earlycon=pl011,mmio32,0xf8b00000 mem=512M rdinit=/init root=/dev/ram0 ro panic=0 loglevel=8 ignore_loglevel net.ifnames=0 blkdevparts=mmcblk0:1M(boot),1M(bootargs),18M(kernel),3800M(rootfs),-(others)"
CONFIG_CMDLINE_FORCE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_HISI_FEMAC=y
CONFIG_PHYLIB=y
CONFIG_MMC_BLOCK=y
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_CPU_ICACHE_DISABLE is not set
# CONFIG_CPU_DCACHE_DISABLE is not set

# A real Debian root needs systemd; allnoconfig leaves these off.
# TMPFS/TMPFS_POSIX_ACL are already set above; only SHMEM gates them.
CONFIG_SHMEM=y
# Debian armhf uses 32-bit time_t: syscall 240 (futex) maps to
# sys_futex_time32, which only exists with this enabled. Without it every
# *_time32 syscall returns ENOSYS and systemd aborts on futex.
CONFIG_COMPAT_32BIT_TIME=y
# Debian armhf glibc expects the legacy 0xffff0000 helper page on some paths.
CONFIG_KUSER_HELPERS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_AIO=y
CONFIG_FHANDLE=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUP_FREEZER=y

# --- System essentials for a real Debian root (from systemd README, 2026-10-28) ---
# Recommendations that were missing, plus what the observed failing units needed.
CONFIG_IPV6=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_BPF_JIT=y
CONFIG_PSI=y
CONFIG_KEYS=y
CONFIG_BLK_DEV_BSG=y
# zram.service failed without these.
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# FAT partitions and removable media.
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ARM Debian static init and normal armhf userspace use Thumb instructions.
CONFIG_ARM_THUMB=y

# --- Gate symbols ---------------------------------------------------------
# These carry no code themselves, but Kconfig hides a whole submenu when they
# are off: the symbols underneath do not even appear as "# ... is not set" in
# .config, they vanish. allnoconfig clears them, which is why ZRAM, BLK_DEV_BSG
# and every NFS option were invisible even though they were listed below.
# All of these are y in the 4.4 BSP config.
CONFIG_BLK_DEV=y
CONFIG_FILE_LOCKING=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NETFILTER_ADVANCED=y

# --- Network: IPv6 firewall, bridging, tagging, sockets -------------------
# ufw.service failed because only the IPv4 tables were built. 4.4 has all of
# these enabled.
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_INET_DIAG=y

# --- cgroup controllers 4.4 exposed and 6.12 lacked ------------------------
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y

# --- NFS client and server ------------------------------------------------
# proc-fs-nfsd.mount and nfs-server.service were failing; with the gate above
# off, no NFS code was built at all. SUNRPC/LOCKD/FSNOTIFY are select-ed by
# Kconfig, so they are deliberately not listed here.
CONFIG_NFS_FS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFSD=y
# NFSv3 server support is implicit in CONFIG_NFSD on Linux 6.12.
CONFIG_NFSD_V4=y

# Required by Debian/iproute2 CLOCK_REALTIME_COARSE.
CONFIG_POSIX_TIMERS=y

# MV100 restart through the SDK SP805 watchdog hardware.
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y

CONFIG_NETFILTER_XT_MATCH_LIMIT=y

CONFIG_NETFILTER_XT_MATCH_HL=y

CONFIG_IP6_NF_MATCH_RT=y

CONFIG_IP6_NF_MATCH_HL=y

CONFIG_IP_NF_TARGET_REJECT=y

CONFIG_IP6_NF_TARGET_REJECT=y

CONFIG_NETFILTER_XT_TARGET_LOG=y

CONFIG_IP_NF_MANGLE=y

CONFIG_HIGH_RES_TIMERS=y

CONFIG_SCHED_MC=y

CONFIG_KERNEL_MODE_NEON=y

CONFIG_FUSE_FS=y

CONFIG_INPUT=y

CONFIG_INPUT_EVDEV=y

CONFIG_HID=y

CONFIG_HID_GENERIC=y

CONFIG_USB_HID=y

CONFIG_USB_ACM=y

CONFIG_USB_SERIAL=y

CONFIG_USB_SERIAL_CH341=y

CONFIG_USB_SERIAL_CP210X=y

CONFIG_IKCONFIG=y

CONFIG_IKCONFIG_PROC=y

CONFIG_CHECKPOINT_RESTORE=y

CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_HID_SUPPORT=y

CONFIG_NTFS3_FS=y

CONFIG_NTFS3_LZX_XPRESS=y

CONFIG_NTFS3_FS_POSIX_ACL=y

CONFIG_WLAN=y

CONFIG_WIRELESS=y

CONFIG_WLAN_VENDOR_REALTEK=y

CONFIG_CFG80211=y

CONFIG_MAC80211=y

CONFIG_NEW_LEDS=y

CONFIG_LEDS_CLASS=y

CONFIG_RTL8XXXU=y

CONFIG_FW_LOADER=y

CONFIG_RFKILL=y

CONFIG_EXTRA_FIRMWARE="rtlwifi/rtl8188eufw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="hi3798/firmware"
