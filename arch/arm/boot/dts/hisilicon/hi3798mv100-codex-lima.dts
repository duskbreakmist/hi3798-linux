/* MV100 GPU compatibility profile. PP1 completion is not yet reliable. */
#include "hi3798mv100-codex-display.dts"
&gpu {
    /* Omit optional PP1 IRQs so Lima exposes and schedules only PP0. */
    interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
                 <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
    interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0", "pmu", "pp";
    status = "okay";
};
