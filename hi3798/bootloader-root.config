CONFIG_INITRAMFS_SOURCE=""
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_EXTEND=y
CONFIG_CMDLINE="console=ttyAMA0,115200 earlycon=pl011,mmio32,0xf8b00000 mem=1G rw rootwait panic=5 loglevel=6 net.ifnames=0 blkdevparts=mmcblk0:1M(boot),1M(bootargs),18M(kernel),3800M(rootfs),-(others) systemd.mask=cloudflared.service"
