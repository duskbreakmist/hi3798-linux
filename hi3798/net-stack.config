# MV100 network stack: nftables / transparent proxy / policy routing / qdisc / BBR
# Requested 2026-11-25, all built-in (=y) on the current 6.12.114 native-KMS config.
#
# TCP_CONG_CUBIC must be written explicitly. With TCP_CONG_ADVANCED=y it becomes
# a visible tristate; the menuconfig workflow replays with allnoconfig only,
# which would clear it and make the "Default TCP congestion control" choice
# fall through to BBR. Explicit y keeps the replay identical to the real .config.

CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SOCKET=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y

# Keep the default-m congestion algorithms off: no extra .ko to deploy.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
